{
  "schemaVersion": 1,
  "id": "ntfy_notify",
  "version": "${version}",

  "name": "Ntfy Notify",
  "description": "Notifies the user through Ntfy upon certain events.",
  "authors": ["Zac99LOL"],
  "contact": {},

  "license": "GPL-3.0",
  "icon": "assets/ntfynotify/icon.png",

  "environment": "client",
  "entrypoints": {
